# ── Required ──────────────────────────────────────────────────────────────────
# Full RTSP URL of the front-yard camera
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream1

# ── vlm_analyzer ─────────────────────────────────────────────────────────────
VLM_BASE_URL=http://localhost:8000
VLM_MODEL=llava
# VLM_PROMPT="You are a security camera…"
CHUNK_SECONDS=30
FRAMES_PER_CHUNK=3

# ── OpenClaw event bus (Redis) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
OPENCLAW_INSIGHTS_STREAM=openclaw:insights
OPENCLAW_ALERTS_STREAM=openclaw:alerts

# ── Detection ─────────────────────────────────────────────────────────────────
# Score threshold to trigger an alert (raise to reduce false positives)
DETECTION_THRESHOLD=2
# Seconds to suppress duplicate alerts
COOLDOWN_SECONDS=300
