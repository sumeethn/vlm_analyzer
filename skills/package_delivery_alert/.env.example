# ── Required ──────────────────────────────────────────────────────────────────
# Full RTSP URL of the front-yard camera
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream1

# Discord incoming webhook URL
# Create one at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── vlm_analyzer ─────────────────────────────────────────────────────────────
# Base URL of the running vlm_analyzer API
VLM_BASE_URL=http://localhost:8000

# Ollama model name (must be pulled: ollama pull llava)
VLM_MODEL=llava

# Prompt sent to the VLM for each chunk (override to tune)
# VLM_PROMPT="You are a security camera…"

# Seconds of video captured per analysis chunk
CHUNK_SECONDS=30

# Number of frames sampled from each chunk and sent to the VLM
FRAMES_PER_CHUNK=3

# ── Polling ──────────────────────────────────────────────────────────────────
# How often (seconds) to poll the insights endpoint
POLL_INTERVAL_SECONDS=15

# ── Detection ────────────────────────────────────────────────────────────────
# Keyword score that must be reached to trigger a notification (integer)
# Higher = fewer false positives; lower = more sensitive
DETECTION_THRESHOLD=2

# Seconds to suppress duplicate notifications after one fires
COOLDOWN_SECONDS=300

# ── Discord (optional) ───────────────────────────────────────────────────────
# A Discord mention string prepended to the alert message, e.g.:
#   "@here"           — notifies everyone online in the channel
#   "<@USER_ID>"      — pings a specific user
#   "<@&ROLE_ID>"     — pings a role
DISCORD_MENTION=@here
