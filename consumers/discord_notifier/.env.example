# ── Required ──────────────────────────────────────────────────────────────────
# Discord incoming webhook URL
# Create one at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Redis / OpenClaw event bus ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
OPENCLAW_ALERTS_STREAM=openclaw:alerts

# ── Discord (optional) ────────────────────────────────────────────────────────
# Mention prepended to every alert message
# Examples: "@here", "<@USER_ID>", "<@&ROLE_ID>"
DISCORD_MENTION=@here
